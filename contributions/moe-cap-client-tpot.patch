+def _mean_client_tpot(results: List[Any]) -> float:
+    """Average client TPOT over requests with at least one token interval."""
+    tpots = []
+    for result in results:
+        output_len = getattr(result, "output_len", 0) or 0
+        latency = getattr(result, "latency", 0) or 0
+        ttft = getattr(result, "ttft", 0) or 0
+        if output_len > 1 and latency >= ttft:
+            tpots.append((latency - ttft) / (output_len - 1))
+    return sum(tpots) / len(tpots) if tpots else 0.0
+
