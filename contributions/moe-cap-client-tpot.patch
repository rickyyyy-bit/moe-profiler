index 0000000..d330ec8
--- /dev/null
+++ b/tests/test_client_tpot_fallback.py
@@ -0,0 +1,54 @@
+"""Tests for the client-side TPOT fallback."""
+
+import ast
+import unittest
+from pathlib import Path
+from types import SimpleNamespace
+from typing import Any, List
+
+
+SOURCE_PATH = (
+    Path(__file__).parents[1] / "moe_cap" / "runner" / "openai_api_profile.py"
+)
+
+
+def _load_helper():
+    source = SOURCE_PATH.read_text(encoding="utf-8")
+    lines = source.splitlines()
+    tree = ast.parse(source)
+    node = next(
+        node
+        for node in tree.body
+        if isinstance(node, ast.FunctionDef) and node.name == "_mean_client_tpot"
+    )
+    namespace = {"Any": Any, "List": List}
+    exec("\n".join(lines[node.lineno - 1 : node.end_lineno]), namespace)
+    return namespace["_mean_client_tpot"]
+
+
+class ClientTPOTFallbackTest(unittest.TestCase):
+    def test_uses_inter_token_interval_count(self):
+        mean_tpot = _load_helper()
+        results = [SimpleNamespace(output_len=5, latency=1.1, ttft=0.1)]
+
+        self.assertAlmostEqual(mean_tpot(results), 0.25)
+
+    def test_ignores_one_token_completion(self):
+        mean_tpot = _load_helper()
+        results = [SimpleNamespace(output_len=1, latency=0.1, ttft=0.1)]
+
+        self.assertEqual(mean_tpot(results), 0.0)
+
+    def test_averages_valid_requests_only(self):
+        mean_tpot = _load_helper()
+        results = [
+            SimpleNamespace(output_len=3, latency=0.5, ttft=0.1),
+            SimpleNamespace(output_len=2, latency=0.4, ttft=0.1),
+            SimpleNamespace(output_len=0, latency=0.0, ttft=0.0),
+        ]
+
+        self.assertAlmostEqual(mean_tpot(results), 0.25)
+
+
+if __name__ == "__main__":
+    unittest.main()
